<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>Invitación — 15 de Agosto</title>
  <style>
/* ====== CONFIGURACIÓN GENERAL ====== */
*{margin:0;padding:0;box-sizing:border-box;}
html,body{width:100%;height:100%;overflow:hidden;font-family:Georgia,serif;background:#061226;color:white;}
body{display:flex;justify-content:center;align-items:center;background:radial-gradient(circle at top,#274472,#08111f 70%);}

/* ===== PANTALLA ===== */
#loading-screen,#letter{position:absolute;width:100%;height:100%;display:flex;justify-content:center;align-items:center;overflow:hidden;}
.hidden{display:none !important;}

/* ===== ESTRELLAS ===== */
.stars{position:absolute;width:100%;height:100%;background-image:radial-gradient(white 1px,transparent 1px);background-size:40px 40px;opacity:.6;animation:twinkle 3s infinite alternate;}
@keyframes twinkle{from{opacity:.4;}to{opacity:1;}}

/* ===== LUNA ===== */
.moon{position:absolute;top:70px;right:60px;width:120px;height:120px;border-radius:50%;background:#fff9d8;box-shadow:0 0 40px #fff,0 0 100px #fff7;}

/* ===== SOBRE ===== */
.envelope-container{position:relative;text-align:center;z-index:5;}
.envelope{
  font-size:90px;
  cursor:pointer;
  animation:float 2s ease-in-out infinite;
  transition:.4s;
  display:inline-block;
  user-select:none;
}
.envelope:focus{outline:3px solid rgba(255,79,139,.35);border-radius:12px;}
.envelope:hover{transform:scale(1.15);}
@keyframes float{0%{transform:translateY(0);}50%{transform:translateY(-12px);}100%{transform:translateY(0);}}

.envelope-container h1{margin-top:20px;font-size:2rem;}
.envelope-container p{margin-top:15px;font-size:1.1rem;opacity:.8;}

/* ===== TARJETA ===== */
.card{width:90%;max-width:700px;background:rgba(255,255,255,.12);backdrop-filter:blur(12px);padding:40px;border-radius:30px;text-align:center;box-shadow:0 0 40px rgba(255,255,255,.15);}
.card h1{font-size:2.5rem;margin-bottom:15px;}
.card h2{margin:20px 0;}
.card p{line-height:1.8;font-size:1.15rem;}
.table{font-size:50px;margin:35px 0;}
.buttons{margin-top:35px;}

/* ===== BOTONES ===== */
button{padding:16px 38px;border:none;border-radius:50px;font-size:22px;cursor:pointer;transition:.3s;margin:15px;font-weight:bold;}
#yes{background:#ff4f8b;color:white;box-shadow:0 0 25px rgba(255,80,140,.6);}
#yes:hover{transform:scale(1.08);box-shadow:0 0 45px rgba(255,80,140,.9);}
#no{background:white;color:#444;position:relative;}

/* ===== LUCIÉRNAGAS ===== */
.fireflies{position:absolute;inset:0;overflow:hidden;pointer-events:none;}
.fireflies::before,.fireflies::after{content:"";position:absolute;width:6px;height:6px;background:#ffe86e;border-radius:50%;box-shadow:0 0 15px #fff799,0 0 30px #ffe86e;animation:fireflyMove 12s linear infinite;}
.fireflies::after{left:75%;top:70%;animation-duration:18s;}
@keyframes fireflyMove{
  0%{transform:translate(0,0);}
  25%{transform:translate(-120px,-80px);}
  50%{transform:translate(80px,-180px);}
  75%{transform:translate(160px,60px);}
  100%{transform:translate(0,0);}
}

/* ===== PÉTALOS ===== */
body::before{
  content:"🌸 🌸 🌸 🌸 🌸 🌸 🌸 🌸";
  position:absolute;left:-10%;top:-40px;width:120%;font-size:28px;opacity:.45;animation:petals 18s linear infinite;white-space:nowrap;
}
@keyframes petals{0%{transform:translateY(-50px) rotate(0deg);}100%{transform:translateY(120vh) rotate(360deg);}}

/* ===== MENSAJE FINAL ===== */
#success{margin-top:30px;animation:fadeIn 1s ease;}
@keyframes fadeIn{from{opacity:0;transform:scale(.8);}to{opacity:1;transform:scale(1);}}

/* Reduced motion: simplify animations */
@media (prefers-reduced-motion: reduce){
  .envelope{animation:none;transition:none;}
  .stars, .fireflies::before, .fireflies::after, body::before{animation:none;}
}
  </style>
</head>
<body>
  <div id="loading-screen" aria-hidden="false">
    <div class="moon" aria-hidden="true"></div>
    <div class="stars" aria-hidden="true"></div>
    <div class="fireflies" aria-hidden="true"></div>

    <div class="envelope-container">
      <div class="envelope" id="openEnvelope" role="button" tabindex="0" aria-label="Abrir sobre">
        💌
      </div>

      <h1>Hay algo muy especial para ti...</h1>
      <p>Toca el sobre para descubrirlo ✨</p>
    </div>
  </div>

  <div id="letter" class="hidden" aria-hidden="true">
    <div class="card" role="dialog" aria-labelledby="inv-title" aria-describedby="message">
      <h1 id="inv-title">🌹 Una invitación 🌹</h1>
      <h2>15 de Agosto</h2>

      <p id="message">
        Desde hace tiempo he querido compartir un momento especial contigo.
        Me encantaría invitarte a una cita.
      </p>

      <div class="table" aria-hidden="true">🕯️ 🍷 🌹 🍝 🕯️</div>

      <h2>¿Aceptarías salir conmigo?</h2>

      <div class="buttons" aria-live="polite">
        <button id="yes" aria-label="Sí, acepto">💖 Sí</button>
        <button id="no" aria-label="No, gracias">😅 No</button>
      </div>

      <div id="success" class="hidden" aria-hidden="true">
        <h1>🥹❤️</h1>
        <h2>¡Sabía que aceptarías!</h2>
        <p>Entonces nos vemos el</p>
        <h1>🌹 15 de Agosto 🌹</h1>
        <p>Será una noche muy especial ✨</p>
      </div>
    </div>
  </div>

  <script>
/* ===== ELEMENTOS ===== */
const envelope = document.getElementById("openEnvelope");
const loading = document.getElementById("loading-screen");
const letter = document.getElementById("letter");

const yes = document.getElementById("yes");
const no = document.getElementById("no");
const success = document.getElementById("success");

/* Accessibility helpers */
function showLetter() {
  loading.classList.add("hidden");
  loading.setAttribute("aria-hidden", "true");
  letter.classList.remove("hidden");
  letter.setAttribute("aria-hidden", "false");
  // focus the Yes button for keyboard users
  yes.focus();
}

/* ===== ABRIR SOBRE ===== */
envelope.addEventListener("click", showLetter);
envelope.addEventListener("keydown", (e) => {
  if (e.key === "Enter" || e.key === " " || e.key === "Spacebar") {
    e.preventDefault();
    showLetter();
  }
});

/* ===== BOTÓN NO ===== */
function moveButton(){
  // keep button inside viewport with margins
  const btnW = 160;
  const btnH = 90;
  const maxX = Math.max(0, window.innerWidth - btnW);
  const maxY = Math.max(0, window.innerHeight - btnH);
  const x = Math.random() * maxX;
  const y = Math.random() * maxY;
  no.style.position = "fixed";
  no.style.left = x + "px";
  no.style.top = y + "px";
  no.blur();
}

// mouseover and click for desktop
no.addEventListener("mouseover", moveButton);
no.addEventListener("click", moveButton);

// touch support for mobile: move on touchstart
no.addEventListener("touchstart", (e) => {
  e.preventDefault();
  moveButton();
}, {passive: false});

/* ===== BOTÓN SÍ ===== */
yes.addEventListener("click", ()=>{
  document.querySelector(".buttons").style.display = "none";
  success.classList.remove("hidden");
  success.setAttribute("aria-hidden","false");
  celebration();
});

/* ===== CELEBRACIÓN ===== */
function celebration(){
  // respect user's reduced-motion preference
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const count = reduced ? 20 : 120;
  for(let i=0;i<count;i++){
    const heart = document.createElement("div");
    const icons = ["❤️","💖","💕","🌸","✨","🌹"];
    heart.innerHTML = icons[Math.floor(Math.random()*icons.length)];
    heart.style.position = "fixed";
    heart.style.left = (Math.random()*100) + "vw";
    heart.style.top = "-30px";
    heart.style.fontSize = (12 + Math.random()*36) + "px";
    heart.style.transition = (reduced ? "2s linear" : "6s linear");
    heart.style.pointerEvents = "none";
    document.body.appendChild(heart);

    // animate
    setTimeout(()=>{
      heart.style.top = "110vh";
      heart.style.transform = `rotate(${Math.random()*720}deg)`;
      heart.style.opacity = reduced ? "0.9" : "1";
    }, 50 + Math.random()*300);

    // cleanup
    setTimeout(()=>{ heart.remove(); }, reduced ? 3000 : 6500);
  }
}

/* Optional: close invitation with Escape key */
document.addEventListener("keydown", (e) => {
  if (e.key === "Escape") {
    if (!loading.classList.contains("hidden")) return;
    // go back to loading screen
    loading.classList.remove("hidden");
    loading.setAttribute("aria-hidden","false");
    letter.classList.add("hidden");
    letter.setAttribute("aria-hidden","true");
    envelope.focus();
  }
});
  </script>
</body>
</html>
